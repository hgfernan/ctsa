94"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="insert_template.sql">INSERT INTO templates (description, text, capability_id) VALUES ('ctsa_ar_templ1.c', 'TO BE DEFINED', 1);
INSERT INTO arguments (description, model_id, value) VALUES ('argument_ar_0001.json', 1, '{ &quot;parameters&quot;: { &quot;init&quot;: { &quot;L&quot;: 5, &quot;n_rows&quot;: 10, &quot;method&quot;: 0 } } }');
INSERT INTO params (description, value, argument_id, capability_id, template_id) VALUES ('param_ar_0001.json', '{ &quot;parameters&quot;: { &quot;init&quot;: { &quot;L&quot;: 5, &quot;n_rows&quot;: 10, &quot;method&quot;: 0 } } }', 1, 1, 1);
</sql><sql name="scratchpad.sql">SELECT MAX(datafile_id) FROM datafiles;
DELETE FROM codes;
SELECT library_id FROM libraries 
	WHERE name = 'ctsa';
SELECT library_id, name, version FROM libraries
	ORDER BY name ASC, 
		version DESC</sql><sql name="update_template.sql">UPDATE params
SET value = '{ &quot;parameters&quot;: { &quot;init&quot;: { &quot;L&quot;: 5, &quot;method&quot;: 0 } } }'
WHERE
    param_id = 1;
	
UPDATE sqlite_sequence
SET seq = 0
WHERE
    name = 'codes';
</sql><current_tab id="2"/></tab_sql></sqlb_project>
